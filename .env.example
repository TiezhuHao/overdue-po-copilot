# Copy to .env and replace every change_me value locally. Never commit .env.
APP_ENV=local
APP_NAME=Overdue PO Copilot - System A
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000

POSTGRES_HOST=localhost
POSTGRES_DB=overdue_po_copilot
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

DATABASE_URL_OWNER=postgresql+psycopg://system_a_owner:change_me@localhost:5432/overdue_po_copilot?connect_timeout=3
DATABASE_URL_API=postgresql+psycopg://system_a_api:change_me@localhost:5432/overdue_po_copilot?connect_timeout=3
DATABASE_URL_GENERATOR=postgresql+psycopg://system_a_generator:change_me@localhost:5432/overdue_po_copilot?connect_timeout=3
DATABASE_URL_EVALUATOR=postgresql+psycopg://system_a_evaluator:change_me@localhost:5432/overdue_po_copilot?connect_timeout=3

# Integration tests require a disposable database whose name contains "test".
TEST_DATABASE_URL=postgresql+psycopg://system_a_owner:change_me@localhost:5432/overdue_po_copilot_test?connect_timeout=3
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://postgres:change_me@localhost:5432/overdue_po_copilot_test?connect_timeout=3
