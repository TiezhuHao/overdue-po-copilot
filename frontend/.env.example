# Server-only backend addresses. No OpenAI credentials belong in this frontend.
SYSTEM_A_API_BASE_URL=http://127.0.0.1:8000/api/v1
SYSTEM_B_API_BASE_URL=http://127.0.0.1:8100/api/v1

# Leave unset for Full Local Stack. The portfolio build script sets this for its child process only.
# NEXT_PUBLIC_PORTFOLIO_DEMO=1
# Optional for repository-scoped GitHub Pages, for example /repository-name.
# NEXT_PUBLIC_BASE_PATH=/repository-name
